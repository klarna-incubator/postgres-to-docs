{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2019",
    "outDir": "dist",
    "sourceMap": true,
    "strict": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts"
  ],
}